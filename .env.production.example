# =============================================================================
# INVENTORY & SALES MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Duplicate this file to .env in production: cp .env.production.example backend/.env
# Review every configuration block before deploying to live infrastructure.

# -----------------------------------------------------------------------------
# APPLICATION CORE
# -----------------------------------------------------------------------------
APP_NAME="Inventory & Sales Management System"
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=base64:GENERATE_PRODUCTION_KEY_WITH_ARTISAN
# CRITICAL: Always keep false in production to prevent leaking stack traces & DB credentials
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://inventory.example.com
FRONTEND_URL=https://inventory.example.com
APP_PORT=80

# -----------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL 8.0)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inventory_db
DB_USERNAME=inventory_user
DB_PASSWORD=your_strong_mysql_password_here
DB_ROOT_PASSWORD=your_strong_root_password_here

# -----------------------------------------------------------------------------
# CACHE, SESSION & QUEUE (Reliable Database Drivers)
# -----------------------------------------------------------------------------
# Queued LowStockAlert notifications run via the database queue driver
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION (Low-Stock Alerts & Daily Digest Delivery)
# -----------------------------------------------------------------------------
# Configure with your SMTP provider (e.g. Amazon SES, Postmark, Mailgun, SendGrid)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@inventory.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# FILESYSTEM STORAGE & IMAGE UPLOADS
# -----------------------------------------------------------------------------
# Uploaded product images and generated invoice PDFs are stored under public storage
FILESYSTEM_DISK=public
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# CORS & SECURITY SETTINGS
# -----------------------------------------------------------------------------
# Restricts API access strictly to your application domain
CORS_ALLOWED_ORIGINS=https://inventory.example.com
SANCTUM_STATEFUL_DOMAINS=inventory.example.com
SESSION_SECURE_COOKIE=true

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
