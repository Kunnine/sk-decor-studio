# =============================================================================
# VERCEL CONTAINER BACKEND ENVIRONMENT TEMPLATE
# Set these variables in Vercel Project Settings -> Environment Variables
# =============================================================================

APP_NAME="SK Decor Studio"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
# Generate locally with: php artisan key:generate --show
APP_KEY=base64:GENERATE_AND_PASTE_KEY_HERE

# Your deployed backend Vercel URL (used for signed PDF URLs)
APP_URL=https://your-backend.vercel.app

# Your deployed frontend Vercel URL (and optional comma-separated extra origins)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Log directly to Vercel runtime logs
LOG_CHANNEL=stderr
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# EXTERNAL CLOUD MYSQL (Recommended: TiDB Cloud Starter free tier)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=inventory_db
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_COLLATION=utf8mb4_general_ci
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Optional: set to "true" ONLY if you want the container to auto-run migrations on boot
RUN_MIGRATIONS_ON_BOOT=false

# -----------------------------------------------------------------------------
# CACHE, SESSION & QUEUE
# -----------------------------------------------------------------------------
# Use sync queue so LowStockAlert emails dispatch immediately inside HTTP requests
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# Protects /api/v1/cron/low-stock-digest (Vercel automatically sends Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-secret-here

# -----------------------------------------------------------------------------
# PERSISTENT OBJECT STORAGE (Cloudflare R2 / AWS S3 / Supabase S3)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=inventory-media
# Example for Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public bucket / CDN base URL returned in image_url, thumb_url, and business_logo_url
AWS_URL=https://pub-your-bucket.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_VISIBILITY=private

# -----------------------------------------------------------------------------
# MAIL (SMTP)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=your_smtp_password_or_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
